{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // vitest.setup.ts is in the program so its "@testing-library/jest-dom" import
  // is seen: that module augments vitest's Assertion type, and without it tsc
  // rejects every toBeInTheDocument even though the tests themselves pass.
  "include": ["src", "vitest.setup.ts"]
}
