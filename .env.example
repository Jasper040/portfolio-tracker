DATABASE_URL=sqlite:///./data/portfolio.sqlite
BASE_CURRENCY=EUR
LOT_METHOD=FIFO
# Browser origins allowed to call the API, comma-separated. Add the fallback port
# if Vite reports "Port 5173 is in use" and moves to 5174.
CORS_ORIGINS=http://localhost:5173
# Corporate-action answers (design doc Sec 6.3). Defaults to config/corporate_actions.yaml
# at the repo root, resolved absolutely so it does not depend on where you run from.
# Set this only if you keep the answers somewhere else.
# CORPORATE_ACTIONS_PATH=
